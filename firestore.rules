rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'muksidui12330@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'displayName', 'username', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        data.username is string && data.username.size() <= 50;
    }

    function isValidPost(data) {
      return data.keys().hasAll(['id', 'authorId', 'authorName', 'content', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.authorId is string && data.authorId.size() <= 128 &&
        data.authorName is string && data.authorName.size() <= 100 &&
        data.content is string && data.content.size() <= 2000;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['id', 'postId', 'authorId', 'authorName', 'text', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.postId is string && data.postId.size() <= 128 &&
        data.authorId is string && data.authorId.size() <= 128 &&
        data.text is string && data.text.size() <= 1000;
    }

    function isValidStory(data) {
      return data.keys().hasAll(['id', 'authorId', 'mediaUrl', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.authorId is string && data.authorId.size() <= 128 &&
        data.mediaUrl is string && data.mediaUrl.size() <= 1000;
    }

    function isValidReel(data) {
      return data.keys().hasAll(['id', 'authorId', 'videoUrl', 'createdAt']) &&
        data.id is string && data.id.size() <= 128 &&
        data.authorId is string && data.authorId.size() <= 128 &&
        data.videoUrl is string && data.videoUrl.size() <= 1000;
    }

    // Health check / test connection
    match /test/{docId} {
      allow read: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isSignedIn() && (
        isOwner(userId) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount', 'postsCount'])
      );
      allow delete: if isOwner(userId);

      // Followers Subcollection
      match /followers/{followerId} {
        allow read: if true;
        allow create, delete: if isOwner(followerId);
      }

      // Following Subcollection
      match /following/{followedId} {
        allow read: if true;
        allow create, delete: if isOwner(userId);
      }

      // Saved Posts Subcollection (Visible strictly to owner)
      match /saved/{postId} {
        allow read, write, delete: if isOwner(userId);
      }

      // Notifications Subcollection
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isSignedIn();
      }
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        isValidPost(request.resource.data);
      allow update: if isSignedIn() && (
        (resource.data.authorId == request.auth.uid && request.resource.data.authorId == request.auth.uid && isValidPost(request.resource.data)) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'sharesCount', 'savesCount'])
      );
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      // Likes Subcollection
      match /likes/{likeUserId} {
        allow read: if true;
        allow create, delete: if isOwner(likeUserId);
      }

      // Comments Subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() &&
          request.resource.data.authorId == request.auth.uid &&
          isValidComment(request.resource.data);
        allow delete: if isSignedIn() && (
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
        );
      }
    }

    // Stories Collection
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        isValidStory(request.resource.data);
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount']);
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;

      // Story Views Subcollection
      match /views/{viewerId} {
        allow read: if isSignedIn();
        allow create, write: if isSignedIn() && request.auth.uid == viewerId;
      }
    }

    // Reels Collection
    match /reels/{reelId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        isValidReel(request.resource.data);
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount']);
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Conversations & Direct/Group Messaging
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() <= 50;
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid in request.resource.data.participants
      );
      allow delete: if isSignedIn() && (
        (resource.data.creatorId == request.auth.uid) ||
        (resource.data.adminIds != null && request.auth.uid in resource.data.adminIds) ||
        (resource.data.isGroup != true && request.auth.uid in resource.data.participants)
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
          request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow delete: if isSignedIn() && (
          resource.data.senderId == request.auth.uid ||
          (
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.adminIds != null &&
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.adminIds
          )
        );
      }
    }

    // Music Studio Tracks
    match /tracks/{trackId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid ||
        isAdmin()
      );
    }

    // WebRTC Voice and Video Calling Signaling
    match /calls/{callId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId
      );
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.callerId;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.callerId ||
        request.auth.uid == resource.data.receiverId
      );

      match /candidates/{candidateId} {
        allow read, write: if isSignedIn();
      }
    }

    // Couple Connect & Private Love Space
    match /couples/{coupleId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.user1Id ||
        request.auth.uid == resource.data.user2Id ||
        request.auth.uid == resource.data.requestedBy ||
        request.auth.uid == resource.data.requestedTo
      );
      allow create: if isSignedIn() && (
        request.auth.uid == request.resource.data.user1Id ||
        request.auth.uid == request.resource.data.requestedBy
      );
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.user1Id ||
        request.auth.uid == resource.data.user2Id ||
        request.auth.uid == resource.data.requestedTo ||
        request.auth.uid == resource.data.requestedBy
      );
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.user1Id ||
        request.auth.uid == resource.data.user2Id ||
        request.auth.uid == resource.data.requestedBy
      );

      // Private Love Memories Album Subcollection
      match /memories/{memoryId} {
        allow read: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/couples/$(coupleId)).data.user1Id ||
          request.auth.uid == get(/databases/$(database)/documents/couples/$(coupleId)).data.user2Id
        );
        allow create, update: if isSignedIn() && (
          request.auth.uid == get(/databases/$(database)/documents/couples/$(coupleId)).data.user1Id ||
          request.auth.uid == get(/databases/$(database)/documents/couples/$(coupleId)).data.user2Id
        );
        allow delete: if isSignedIn() && (
          request.auth.uid == resource.data.authorId ||
          request.auth.uid == get(/databases/$(database)/documents/couples/$(coupleId)).data.user1Id ||
          request.auth.uid == get(/databases/$(database)/documents/couples/$(coupleId)).data.user2Id
        );
      }
    }

    // Abuse Reports
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, delete: if isAdmin();
    }
  }
}

