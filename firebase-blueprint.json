{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with personal and social details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "bio": { "type": "string", "maxLength": 500 },
        "website": { "type": "string", "maxLength": 200 },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "postsCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "blockedUsers": { "type": "array" }
      },
      "required": ["id", "displayName", "username", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "A social post created by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorUsername": { "type": "string", "maxLength": 50 },
        "authorPhoto": { "type": "string", "maxLength": 1000 },
        "content": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "tags": { "type": "array" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "category": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "authorId", "authorName", "content", "createdAt"]
    },
    "Like": {
      "title": "Post Like",
      "description": "Like record on a post",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "postId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "postId", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment on a post",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "postId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorPhoto": { "type": "string", "maxLength": 1000 },
        "text": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "postId", "authorId", "authorName", "text", "createdAt"]
    },
    "Story": {
      "title": "Story",
      "description": "24-hour visual story",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorPhoto": { "type": "string", "maxLength": 1000 },
        "mediaUrl": { "type": "string", "maxLength": 1000 },
        "caption": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "number" }
      },
      "required": ["id", "authorId", "mediaUrl", "createdAt"]
    },
    "Reel": {
      "title": "Reel",
      "description": "Short form video or clip with audio title",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorPhoto": { "type": "string", "maxLength": 1000 },
        "videoUrl": { "type": "string", "maxLength": 1000 },
        "caption": { "type": "string", "maxLength": 500 },
        "soundTitle": { "type": "string", "maxLength": 100 },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "authorId", "videoUrl", "createdAt"]
    },
    "Follow": {
      "title": "Follow Relationship",
      "description": "Follower to user relationship",
      "type": "object",
      "properties": {
        "followerId": { "type": "string", "maxLength": 128 },
        "followedId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" }
      },
      "required": ["followerId", "followedId", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Chat thread between users or groups",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "isGroup": { "type": "boolean" },
        "name": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "participants": { "type": "array" },
        "adminIds": { "type": "array" },
        "creatorId": { "type": "string", "maxLength": 128 },
        "adminsOnlySettings": { "type": "boolean" },
        "lastMessage": { "type": "string", "maxLength": 1000 },
        "lastMessageTime": { "type": "string" },
        "lastSenderId": { "type": "string", "maxLength": 128 },
        "readBy": { "type": "object" },
        "systemAuditLog": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "participants", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Message in a direct or group conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderPhoto": { "type": "string", "maxLength": 1000 },
        "text": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "mediaType": { "type": "string", "maxLength": 50 },
        "readBy": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "conversationId", "senderId", "text", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app user notification",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderPhoto": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "maxLength": 50 },
        "targetId": { "type": "string", "maxLength": 128 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "senderId", "type", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "User flag or violation report",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reporterId": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "maxLength": 50 },
        "targetId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "reporterId", "targetType", "targetId", "reason", "createdAt"]
    },
    "Couple": {
      "title": "Couple Connect",
      "description": "Mutual-consent couple pairing and relationship data",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "user1Id": { "type": "string", "maxLength": 128 },
        "user2Id": { "type": "string", "maxLength": 128 },
        "requestedBy": { "type": "string", "maxLength": 128 },
        "requestedTo": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 30 },
        "partner1Name": { "type": "string", "maxLength": 100 },
        "partner2Name": { "type": "string", "maxLength": 100 },
        "partner1Username": { "type": "string", "maxLength": 50 },
        "partner2Username": { "type": "string", "maxLength": 50 },
        "anniversaryDate": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "user1Id", "user2Id", "status", "createdAt"]
    },
    "LoveMemory": {
      "title": "Love Memory",
      "description": "Private romantic memories and album photos",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "coupleId": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 100 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "title": { "type": "string", "maxLength": 200 },
        "caption": { "type": "string", "maxLength": 1000 },
        "memoryDate": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "coupleId", "authorId", "imageUrl", "title", "memoryDate", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Public and user profiles"
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "All public posts in the feed"
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": { "$ref": "#/entities/Like" },
      "description": "Likes on a specific post"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Comments on a post"
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "24-hour visual stories"
    },
    "/reels/{reelId}": {
      "schema": { "$ref": "#/entities/Reel" },
      "description": "Short video reels feed"
    },
    "/users/{userId}/followers/{followerId}": {
      "schema": { "$ref": "#/entities/Follow" },
      "description": "Followers list of a user"
    },
    "/users/{userId}/following/{followedId}": {
      "schema": { "$ref": "#/entities/Follow" },
      "description": "Following list of a user"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Chat conversations"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages inside a conversation"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications"
    },
    "/couples/{coupleId}": {
      "schema": { "$ref": "#/entities/Couple" },
      "description": "Couple Connect pairing and dashboard details"
    },
    "/couples/{coupleId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/LoveMemory" },
      "description": "Private love memories and photos"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Abuse and moderation reports"
    }
  }
}
